{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/api", "dest": "api/index.js" },

    { "src": "/public/(.*)", "dest": "api/index.js" },
    { "src": "/public", "dest": "api/index.js" }
  ]
}
